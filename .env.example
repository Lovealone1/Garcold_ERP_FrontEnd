# API base URL used by axios.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Realtime WebSocket endpoint. Must be the full ws:// or wss:// URL including
# the path; the client appends ?token=<supabase access token>.
# Without it the app runs fine but receives no realtime updates -- the client
# keeps retrying and logs the reason rather than failing silently.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/realtime

NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
